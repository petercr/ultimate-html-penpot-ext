{
  "name": "ultimate-html-to-penpot",
  "private": true,
  "version": "0.1.0",
  "description": "Turn pasted HTML into editable responsive Penpot boards.",
  "license": "MIT",
  "repository": "github:petercr/ultimate-html-penpot-ext",
  "bugs": "https://github.com/petercr/ultimate-html-penpot-ext/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names ui,plugin,serve \"vite build --watch --emptyOutDir false\" \"vite build --config vite.plugin.config.ts --watch\" \"vite preview --host 0.0.0.0 --strictPort\"",
    "build": "tsc --noEmit && vite build && vite build --config vite.plugin.config.ts",
    "check:api": "tsc -p api --noEmit",
    "check:worker": "tsc -p cloudflare --noEmit",
    "check:dist": "node scripts/validate-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:worker": "wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@penpot/plugin-styles": "^1.4.2",
    "@penpot/plugin-types": "^1.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
